#!/usr/bin/env bash
set -u

emit_ok() {
  python3 - "$1" <<'PY'
import json
import sys
print(json.dumps({"ok": True, "path": sys.argv[1]}, separators=(",", ":")))
PY
}

emit_err() {
  python3 - "$1" "$2" <<'PY'
import json
import sys
print(json.dumps({"ok": False, "error": {"code": sys.argv[1], "message": sys.argv[2]}}, separators=(",", ":")))
PY
}

if [ "$#" -eq 2 ]; then
  root=$1
  query=$2
elif [ "$#" -eq 4 ] && [ "$1" = "--root" ] && [ "$3" = "--query" ]; then
  root=$2
  query=$4
else
  emit_err REQUEST_INVALID "usage: find-user-motion ROOT QUERY"
  exit 2
fi

if [ -z "$query" ]; then
  emit_err REQUEST_INVALID "query must be non-empty"
  exit 2
fi

if [ ! -d "$root" ]; then
  emit_err REQUEST_INVALID "user-motion root does not exist"
  exit 2
fi

root_real=$(realpath -m -- "$root") || {
  emit_err REQUEST_INVALID "could not resolve user-motion root"
  exit 2
}

qbase=${query##*/}
qstem=$qbase
if [[ "$qstem" == *.trk ]]; then
  qstem=${qstem%.trk}
fi

if [ -z "$qstem" ]; then
  emit_err REQUEST_INVALID "query stem must be non-empty"
  exit 2
fi

exact=()
contains=()
while IFS= read -r -d '' file; do
  real=$(realpath -e -- "$file") || continue
  case "$real" in
    "$root_real"/*) ;;
    *) continue ;;
  esac
  base=${file##*/}
  stem=${base%.trk}
  if [ "$stem" = "$qstem" ]; then
    exact+=("$real")
  elif [[ "$base" == *"$query"* || "$base" == *"$qstem"* || "$stem" == *"$qstem"* ]]; then
    contains+=("$real")
  fi
done < <(find "$root_real" -type f -name '*.trk' -print0 | sort -z)

if [ "${#exact[@]}" -eq 1 ]; then
  emit_ok "${exact[0]}"
  exit 0
fi

if [ "${#exact[@]}" -gt 1 ]; then
  emit_err AMBIGUOUS "multiple .trk files have the requested stem"
  exit 1
fi

if [ "${#contains[@]}" -eq 1 ]; then
  emit_ok "${contains[0]}"
  exit 0
fi

if [ "${#contains[@]}" -gt 1 ]; then
  emit_err AMBIGUOUS "multiple .trk files match the query"
  exit 1
fi

emit_err NOT_FOUND "no matching .trk file found"
exit 1
