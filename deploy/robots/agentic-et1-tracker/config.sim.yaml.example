agentic_et1_tracker:
  bind: "127.0.0.1"
  port: 8083
  network: "lo"
  domain_id: 0
  lowcmd_startup_preflight_ms: 200
  release_motion_mode_on_startup: false
  mode_machine: 0
  motion_dirs:
    - "/home/galbot/works/agent-test/generated"
  queue_limit: 8
  recent_limit: 32
  max_track_duration_s: 120
  stop_hold_s: 0.0
  transition_duration_s: 0.7
  transition_min_frames: 2
  transition_duration_dt_tolerance_s: 1.0e-9
  user_bridge_reduced_startup_hold_s: 0.10
  transition_root_yaw_residual_limit_rad: 0.05
  transition_contact_guard: "same_nonzero_contact"
  transition_max_velocity: 250.0
  transition_max_acceleration: 10000.0
  transition_max_jerk: 1000000.0
  idle_mode: "hold_current"
  reference:
    enabled: true
  # Simulation-only example for /execute_loco_upper.
  # This stays disabled by default; set enabled: true manually only when
  # testing /execute_loco_upper in simulation.
  loco_upper:
    enabled: false
    policy_dir: "config/policy/loco_lower/et1_low"
    policy_file: "policy.onnx"
    deploy: "config/policy/loco_lower/et1_low/params/deploy_lowobs10k.yaml"
    default_radius_m: 0.8
    max_radius_m: 2.0
    radius_tolerance_m: 0.05
    max_hold_s: 10.0
    strict_pose: false
    limits: "config/limits/et1_upper_body/v0/limits.yaml"
    joint_map: "config/limits/et1_upper_body/v0/joint_map.yaml"
  policy:
    profile: "GeneralTrackerDR3"
    policy_dir: "config/policy/general_tracker_dr3"
    policy_file: "DR3-all.onnx"
    deploy: "config/policy/general_tracker_dr3/params/deploy_fut_obs.yaml"
    fps: 50
  control:
    startup_control: "FixStand"
    velocity_policy_dir: "config/policy/velocity/v0"
    velocity_policy_file: "policy.onnx"
    velocity_deploy: "config/policy/velocity/v0/params/deploy.yaml"
    fixstand_config: "config/posture/fixstand/v0/fixstand.yaml"
    passive_config: "config/posture/passive/v0/passive.yaml"
